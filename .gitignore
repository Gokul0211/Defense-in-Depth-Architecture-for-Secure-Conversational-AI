# =====================================================================
# DIDA -- what is NOT pushed.
# The repo ships the code (sentinel/, dashboard/, main.py), its configs and
# requirements, README.md and results.md. Everything else stays local.
# =====================================================================

# --- Secrets ----------------------------------------------------------
.env
.env.*
!.env.example

# --- Python / tooling artefacts ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Virtual environments ---------------------------------------------
venv/
env/
.venv/
.venv-*/
ENV/

# --- IDEs, OS, assistant state -----------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/
CLAUDE.md

# --- Tests (not published) ----------------------------------------------
tests/
test/
test_*.py
*_test.py
pytest.ini
requirements-dev.txt

# --- Paper sources and submission material -------------------------------
paper/
*.zip

